# Copy to .env (git-ignored). scripts\run.ps1 loads it.
# LLM OCR backend for --llm-ocr:
#   codex  = Codex CLI signed in with ChatGPT (subscription usage; run `codex login` once)
#   openai = OpenAI API (needs OPENAI_API_KEY from platform.openai.com, billed per token)
LIBRARIAN_OCR_BACKEND=codex
LIBRARIAN_OCR_WORKERS=3
# LIBRARIAN_CODEX_MODEL=
LIBRARIAN_CODEX_TIMEOUT=300
OPENAI_API_KEY=
LIBRARIAN_OCR_MODEL=gpt-4.1
# Embedder: sentence-transformers on the GPU (default) or Ollama.
LIBRARIAN_EMBED=st:BAAI/bge-base-en-v1.5
# LIBRARIAN_EMBED=ollama:nomic-embed-text
LIBRARIAN_EMBED_BATCH=64
# nougat via the legacy docker image (with --nougat, or `librarian nougat-test`)
LIBRARIAN_NOUGAT_MODELS=D:\Readings\indexes\lra\nougat-models
LIBRARIAN_NOUGAT_IMAGE=lra-nougat-pilot:0.1.17
LIBRARIAN_NOUGAT_MODEL=0.1.0-small
LIBRARIAN_NOUGAT_BATCH=4
# Query expansion for descriptive searches via a local Ollama chat model ('none' to disable).
LIBRARIAN_EXPAND=ollama
LIBRARIAN_EXPAND_MODEL=llama3.1:8b

# Hugging Face model cache (embedder, reranker) off C:
HF_HOME=D:\Models\huggingface
